NODE_ENV=development
PORT=3002

# Copy the URI privately from the existing CryptoNet backend environment.
MONGODB_URI=
DB_NAME=cryptonet

PAYMENT_SESSIONS_COLLECTION=paymentSessions
PAYMENT_EVENTS_COLLECTION=paymentEvents

PAYMENT_MODE=DEMO
FRONTEND_ORIGIN=http://localhost:3000
CRYPTONET_API_URL=http://localhost:3001/api

# Generate a private service-to-service API key; never commit the real value.
PAYMENT_API_KEY=replace-with-a-random-secret-at-least-32-characters

# Fixture records are trusted only in development and must reflect a known
# test request. Production does not accept caller-supplied payment context.
PAYMENT_CONTEXT_MODE=DEVELOPMENT_FIXTURE
PAYMENT_CONTEXT_FIXTURES_JSON=[]
